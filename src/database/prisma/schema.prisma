// Fuzzer Scanner — database schema.
//
// Conventions (PLAN.md §3):
//   - every table: `id UUID` primary key generated by Postgres, constraint `pk_<table>`
//   - every relationship: real UUID FK column, constraint `fk_<table>_<column>`,
//     explicit ON DELETE / ON UPDATE, and an index whose leading column is the FK
//   - constraint/index names are pinned with `map:` so migrations, the migration
//     verification test and error mapping all refer to the same names.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  QUEUED
  FUZZING
  RESOLVING
  ENRICHING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanTrigger {
  API
  SCHEDULE
  RESCAN
}

enum DomainStatus {
  NEW
  ACTIVE
  PARKED
  INACTIVE
  UNDER_REVIEW
  CONFIRMED_THREAT
  FALSE_POSITIVE
  TAKEN_DOWN
  ALLOWLISTED
}

enum ThreatLevel {
  UNSCORED
  LOW_RISK
  MEDIUM_RISK
  HIGH_RISK
}

enum ScreenshotStatus {
  PENDING
  CAPTURED
  FAILED
  SKIPPED
}

enum WhoisSource {
  RDAP
  WHOIS
}

enum ReviewVerdict {
  MALICIOUS
  SUSPICIOUS
  BENIGN
  FALSE_POSITIVE
  NEEDS_INFO
}

/// Brands/domains the customer owns and wants monitored.
enum AlertChannelType {
  WEBHOOK
  SLACK
  EMAIL
}

enum AlertEventType {
  HIGH_RISK
  NEW_LOOKALIKE
  WENT_LIVE
  CONFIRMED_THREAT
}

enum AlertMode {
  IMMEDIATE
  DIGEST
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model OriginalDomain {
  id                 String              @id(map: "pk_original_domains") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain             String              @unique(map: "uq_original_domains_domain")
  unicodeDomain      String              @map("unicode_domain")
  label              String?
  isActive           Boolean             @default(true) @map("is_active")
  scanSchedule       String?             @map("scan_schedule")
  scanOptions        Json                @default("{}") @map("scan_options")
  lastScannedAt      DateTime?           @map("last_scanned_at") @db.Timestamptz(3)
  scans              Scan[]
  scannedDomains     ScannedDomain[]
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  alertSubscriptions AlertSubscription[]
  brandReference     BrandReference?

  @@map("original_domains")
}

/// One row per scan run — what the trigger API returns and polls.
model Scan {
  id                String          @id(map: "pk_scans") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalDomainId  String          @map("original_domain_id") @db.Uuid
  originalDomain    OriginalDomain  @relation(fields: [originalDomainId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_scans_original_domain_id")
  status            ScanStatus      @default(QUEUED)
  triggeredBy       ScanTrigger     @default(API) @map("triggered_by")
  options           Json            @default("{}")
  permutationsTotal Int             @default(0) @map("permutations_total")
  resolvedCount     Int             @default(0) @map("resolved_count")
  registeredCount   Int             @default(0) @map("registered_count")
  newCount          Int             @default(0) @map("new_count")
  failedCount       Int             @default(0) @map("failed_count")
  errorMessage      String?         @map("error_message")
  idempotencyKey    String?         @unique(map: "uq_scans_idempotency_key") @map("idempotency_key")
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?       @map("finished_at") @db.Timestamptz(3)
  analytics         Analytics[]
  screenshots       Screenshot[]
  lastSeenDomains   ScannedDomain[] @relation("ScannedDomainLastScan")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// At most one in-flight scan per original domain — enforced by Postgres, not app code.
  /// The predicate is written in Postgres's canonical form so `migrate diff` sees no drift.
  @@unique([originalDomainId], where: raw("status = ANY (ARRAY['QUEUED'::\"ScanStatus\", 'FUZZING'::\"ScanStatus\", 'RESOLVING'::\"ScanStatus\", 'ENRICHING'::\"ScanStatus\"])"), map: "uq_scans_active_original_domain")
  @@index([originalDomainId, createdAt(sort: Desc)], map: "ix_scans_original_domain_id_created_at")
  @@index([status], map: "ix_scans_status")
  @@index([createdAt], map: "ix_scans_created_at")
  @@map("scans")
}

/// A registered permutation of an original domain.
model ScannedDomain {
  id                String             @id(map: "pk_scanned_domains") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalDomainId  String             @map("original_domain_id") @db.Uuid
  originalDomain    OriginalDomain     @relation(fields: [originalDomainId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_scanned_domains_original_domain_id")
  lastScanId        String?            @map("last_scan_id") @db.Uuid
  lastScan          Scan?              @relation("ScannedDomainLastScan", fields: [lastScanId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_scanned_domains_last_scan_id")
  domain            String
  unicodeDomain     String             @map("unicode_domain")
  fuzzer            String
  dnsA              String[]           @map("dns_a")
  dnsAaaa           String[]           @map("dns_aaaa")
  dnsMx             String[]           @map("dns_mx")
  dnsNs             String[]           @map("dns_ns")
  dnsTtl            Int?               @map("dns_ttl")
  /// SERVFAIL / TIMEOUT / DNS_EXCEPTION outcomes from the last resolution (empty when clean).
  dnsErrors         String[]           @map("dns_errors")
  status            DomainStatus       @default(NEW)
  riskScore         Int                @default(0) @map("risk_score")
  threatLevel       ThreatLevel        @default(UNSCORED) @map("threat_level")
  tags              String[]
  firstSeenAt       DateTime           @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt        DateTime           @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  whoisInformations WhoisInformation[]
  screenshots       Screenshot[]
  reviews           Review[]
  analytics         Analytics[]
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  alertDeliveries AlertDelivery[]

  @@unique([originalDomainId, domain], map: "uq_scanned_domains_original_domain_id_domain")
  @@index([lastScanId], map: "ix_scanned_domains_last_scan_id")
  @@index([threatLevel, riskScore(sort: Desc)], map: "ix_scanned_domains_threat_level_risk_score")
  @@index([status], map: "ix_scanned_domains_status")
  @@index([lastSeenAt], map: "ix_scanned_domains_last_seen_at")
  @@index([deletedAt], map: "ix_scanned_domains_deleted_at")
  @@index([dnsA(ops: ArrayOps)], type: Gin, map: "ix_scanned_domains_dns_a")
  @@index([dnsNs(ops: ArrayOps)], type: Gin, map: "ix_scanned_domains_dns_ns")
  @@index([dnsMx(ops: ArrayOps)], type: Gin, map: "ix_scanned_domains_dns_mx")
  @@map("scanned_domains")
}

/// WHOIS/RDAP snapshots (append-only; latest = max(fetched_at)).
model WhoisInformation {
  id                String        @id(map: "pk_whois_informations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scannedDomainId   String        @map("scanned_domain_id") @db.Uuid
  scannedDomain     ScannedDomain @relation(fields: [scannedDomainId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_whois_informations_scanned_domain_id")
  source            WhoisSource
  registrar         String?
  registrantOrg     String?       @map("registrant_org")
  registrantCountry String?       @map("registrant_country")
  abuseEmail        String?       @map("abuse_email")
  emails            String[]
  nameServers       String[]      @map("name_servers")
  statuses          String[]
  dnssec            String?
  whoisServer       String?       @map("whois_server")
  createdDate       DateTime?     @map("created_date") @db.Timestamptz(3)
  updatedDate       DateTime?     @map("updated_date") @db.Timestamptz(3)
  expiresDate       DateTime?     @map("expires_date") @db.Timestamptz(3)
  rawText           String?       @map("raw_text")
  parseSucceeded    Boolean       @default(true) @map("parse_succeeded")
  fetchedAt         DateTime      @default(now()) @map("fetched_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([scannedDomainId, fetchedAt(sort: Desc)], map: "ix_whois_informations_scanned_domain_id_fetched_at")
  @@index([fetchedAt], map: "ix_whois_informations_fetched_at")
  @@map("whois_informations")
}

/// Website captures via Selenium; the image lives in S3/MinIO under storage_key.
model Screenshot {
  id                   String           @id(map: "pk_screenshots") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scannedDomainId      String           @map("scanned_domain_id") @db.Uuid
  scannedDomain        ScannedDomain    @relation(fields: [scannedDomainId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_screenshots_scanned_domain_id")
  scanId               String?          @map("scan_id") @db.Uuid
  scan                 Scan?            @relation(fields: [scanId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_screenshots_scan_id")
  status               ScreenshotStatus @default(PENDING)
  storageBucket        String?          @map("storage_bucket")
  storageKey           String?          @unique(map: "uq_screenshots_storage_key") @map("storage_key")
  mimeType             String?          @map("mime_type")
  sizeBytes            Int?             @map("size_bytes")
  width                Int?
  height               Int?
  requestedUrl         String           @map("requested_url")
  finalUrl             String?          @map("final_url")
  httpStatus           Int?             @map("http_status")
  pageTitle            String?          @map("page_title")
  perceptualHash       String?          @map("perceptual_hash")
  similarityToOriginal Float?           @map("similarity_to_original")
  errorMessage         String?          @map("error_message")
  capturedAt           DateTime?        @map("captured_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  faviconHash String? @map("favicon_hash") @db.VarChar(64)
  pageSignals Json?   @map("page_signals")

  @@index([scannedDomainId, createdAt(sort: Desc)], map: "ix_screenshots_scanned_domain_id_created_at")
  @@index([scanId], map: "ix_screenshots_scan_id")
  @@index([createdAt], map: "ix_screenshots_created_at")
  @@map("screenshots")
}

/// Analyst decisions. A review may change the scanned domain's status (via event).
model Review {
  id              String        @id(map: "pk_reviews") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scannedDomainId String        @map("scanned_domain_id") @db.Uuid
  scannedDomain   ScannedDomain @relation(fields: [scannedDomainId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_reviews_scanned_domain_id")
  verdict         ReviewVerdict
  notes           String?
  /// API-key name in v1 (no users table yet).
  reviewer        String
  previousStatus  DomainStatus  @map("previous_status")
  newStatus       DomainStatus  @map("new_status")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([scannedDomainId, createdAt(sort: Desc)], map: "ix_reviews_scanned_domain_id_created_at")
  @@map("reviews")
}

/// Rule-engine scoring results per scanned domain per scan (append-only time series).
model Analytics {
  id                  String        @id(map: "pk_analytics") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scannedDomainId     String        @map("scanned_domain_id") @db.Uuid
  scannedDomain       ScannedDomain @relation(fields: [scannedDomainId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_analytics_scanned_domain_id")
  scanId              String?       @map("scan_id") @db.Uuid
  scan                Scan?         @relation(fields: [scanId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_analytics_scan_id")
  totalScore          Int           @map("total_score")
  threatLevel         ThreatLevel   @map("threat_level")
  ruleResults         Json          @map("rule_results")
  levenshteinDistance Int?          @map("levenshtein_distance")
  domainAgeDays       Int?          @map("domain_age_days")
  sslStatus           String?       @map("ssl_status")
  dmarcPolicy         String?       @map("dmarc_policy")
  hasMx               Boolean?      @map("has_mx")
  spamhausListed      Boolean?      @map("spamhaus_listed")
  reputationHit       Boolean?      @map("reputation_hit")
  computedAt          DateTime      @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@index([scannedDomainId, computedAt(sort: Desc)], map: "ix_analytics_scanned_domain_id_computed_at")
  @@index([scanId], map: "ix_analytics_scan_id")
  @@index([threatLevel, computedAt], map: "ix_analytics_threat_level_computed_at")
  @@index([computedAt], map: "ix_analytics_computed_at")
  @@map("analytics")
}

/// DB-configurable scoring rules (seeded from Reporting's rule_configs).
model RuleConfig {
  id        String   @id(map: "pk_rule_configs") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique(map: "uq_rule_configs_key")
  name      String
  enabled   Boolean  @default(true)
  points    Json
  params    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("rule_configs")
}

/// Score-band cutoffs (singleton row key = "global_score").
model ScoringThreshold {
  id                  String   @id(map: "pk_scoring_thresholds") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String   @unique(map: "uq_scoring_thresholds_key")
  thresholdMediumRisk Int      @default(80) @map("threshold_medium_risk")
  thresholdLowRisk    Int      @default(40) @map("threshold_low_risk")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("scoring_thresholds")
}

/// Transactional outbox: after-commit events written in the producing transaction (PLAN.md §1.2).
model OutboxEvent {
  id          String    @id(map: "pk_outbox_events") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName   String    @map("event_name") @db.VarChar(120)
  payload     Json
  origin      String    @db.VarChar(16)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([origin, availableAt], map: "ix_outbox_events_origin_available_at")
  @@index([failedAt], map: "ix_outbox_events_failed_at")
  @@map("outbox_events")
}

/// Where alerts are sent (PLAN.md §14 #6). Target + signing secret are AES-256-GCM encrypted.
model AlertChannel {
  id                     String              @id(map: "pk_alert_channels") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String              @unique(map: "uq_alert_channels_name") @db.VarChar(100)
  type                   AlertChannelType
  targetEncrypted        String              @map("target_encrypted")
  targetHint             String              @map("target_hint") @db.VarChar(200)
  signingSecretEncrypted String?             @map("signing_secret_encrypted")
  isActive               Boolean             @default(true) @map("is_active")
  createdBy              String              @map("created_by") @db.VarChar(254)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions          AlertSubscription[]
  deliveries             AlertDelivery[]

  @@map("alert_channels")
}

/// Which events of which brand (null = all brands) reach a channel, immediately or as a digest.
model AlertSubscription {
  id               String           @id(map: "pk_alert_subscriptions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId        String           @map("channel_id") @db.Uuid
  channel          AlertChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_alert_subscriptions_channel_id")
  originalDomainId String?          @map("original_domain_id") @db.Uuid
  originalDomain   OriginalDomain?  @relation(fields: [originalDomainId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_alert_subscriptions_original_domain_id")
  eventTypes       AlertEventType[] @map("event_types")
  minRiskScore     Int              @default(0) @map("min_risk_score")
  mode             AlertMode        @default(IMMEDIATE)
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries       AlertDelivery[]

  @@index([channelId], map: "ix_alert_subscriptions_channel_id")
  @@index([originalDomainId], map: "ix_alert_subscriptions_original_domain_id")
  @@map("alert_subscriptions")
}

/// One alert for one subscription; `dedupeKey` (subscription + event + look-alike + day) makes raising idempotent.
model AlertDelivery {
  id              String              @id(map: "pk_alert_deliveries") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId  String              @map("subscription_id") @db.Uuid
  subscription    AlertSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_alert_deliveries_subscription_id")
  channelId       String              @map("channel_id") @db.Uuid
  channel         AlertChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_alert_deliveries_channel_id")
  scannedDomainId String?             @map("scanned_domain_id") @db.Uuid
  scannedDomain   ScannedDomain?      @relation(fields: [scannedDomainId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_alert_deliveries_scanned_domain_id")
  eventType       AlertEventType      @map("event_type")
  mode            AlertMode
  dedupeKey       String              @unique(map: "uq_alert_deliveries_dedupe_key") @map("dedupe_key") @db.VarChar(200)
  payload         Json
  status          AlertDeliveryStatus @default(PENDING)
  attempts        Int                 @default(0)
  lastError       String?             @map("last_error")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(3)

  @@index([subscriptionId], map: "ix_alert_deliveries_subscription_id")
  @@index([channelId, status], map: "ix_alert_deliveries_channel_id_status")
  @@index([scannedDomainId], map: "ix_alert_deliveries_scanned_domain_id")
  @@index([createdAt], map: "ix_alert_deliveries_created_at")
  @@map("alert_deliveries")
}

/// The brand's own landing page, compared against look-alike screenshots (PLAN.md §14 #3).
model BrandReference {
  id               String           @id(map: "pk_brand_references") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalDomainId String           @unique(map: "uq_brand_references_original_domain_id") @map("original_domain_id") @db.Uuid
  originalDomain   OriginalDomain   @relation(fields: [originalDomainId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_brand_references_original_domain_id")
  status           ScreenshotStatus
  storageKey       String?          @map("storage_key") @db.VarChar(255)
  perceptualHash   String?          @map("perceptual_hash") @db.VarChar(16)
  faviconHash      String?          @map("favicon_hash") @db.VarChar(64)
  pageTitle        String?          @map("page_title")
  finalUrl         String?          @map("final_url")
  errorMessage     String?          @map("error_message")
  capturedAt       DateTime?        @map("captured_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brand_references")
}
