{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/fuzzer/dictionaries/*",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "modules/whois-informations/data/*",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  }
}
