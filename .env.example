# ─── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# json | pretty (defaults: json in production, pretty otherwise)
LOG_FORMAT=
LOG_TO_FILE=false
LOG_DIR=logs
SWAGGER_ENABLED=true

# ─── PostgreSQL (>= 13) ────────────────────────────────────────────────
DATABASE_URL=postgresql://fuzzer:fuzzer@localhost:5432/fuzzer_scanner?schema=public

# ─── Redis — password is REQUIRED (min 16 chars in production) ────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=change-me-to-a-long-random-secret
REDIS_TLS=false
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1

# ─── API keys: comma-separated name:scope:sha256(key) ─────────────────
# Generate: npm run apikey:generate -- <name> <read|write|admin>
API_KEYS=

# ─── S3 / MinIO ────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fuzzer-screenshots
S3_ACCESS_KEY_ID=fuzzer
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=300
# Empty = bucket default encryption (S3 default). Set AES256 / aws:kms to send an explicit SSE header.
S3_SSE=

# ─── Selenium Grid ─────────────────────────────────────────────────────
SELENIUM_URL=http://localhost:4444
HEALTH_CHECK_SELENIUM=true

# ─── DNS resolution & scans ───────────────────────────────────────────
# Comma-separated resolver IPs; empty = 16 public resolvers (same pool as Reporting)
DNS_NAMESERVERS=
DNS_TIMEOUT_MS=3000
DNS_RETRIES=2
DNS_CONCURRENCY=100
SCAN_BATCH_SIZE=500
SCAN_MAX_PERMUTATIONS=150000

# ─── Enrichment (WHOIS / screenshots / scoring) ───────────────────────
WHOIS_REFRESH_DAYS=7
WHOIS_TIMEOUT_MS=10000
# IANA RDAP bootstrap; override for an internal mirror (or the load-test stub).
# RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
SCREENSHOT_PAGE_TIMEOUT_MS=20000
SCREENSHOT_CONCURRENCY=4
RULE_NETWORK_TIMEOUT_MS=5000
RULES_CACHE_TTL_MS=60000

# ─── Reputation: manage-feed indicators via the threat-feed API ──────
# Use a dedicated threat-feed user whose role allows GET /feeds (read-only is enough in Phase 2).
THREAT_FEED_ENABLED=false
THREAT_FEED_URL=http://localhost:8080/api/v1
THREAT_FEED_EMAIL=
THREAT_FEED_PASSWORD=
THREAT_FEED_TIMEOUT_MS=5000
# Publish CONFIRMED_THREAT look-alikes as DOMAIN indicators (requires THREAT_FEED_ENABLED=true).
# The service account's role needs GET/POST/PATCH /feeds, plus GET/POST /sources unless
# THREAT_FEED_SOURCE_ID is set.
THREAT_FEED_PUSH_ENABLED=false
THREAT_FEED_SOURCE_NAME=Fuzzer Scanner
# THREAT_FEED_SOURCE_ID=
REPUTATION_CACHE_TTL_S=3600
REPUTATION_MISS_TTL_S=600

# ─── Retention ─────────────────────────────────────────────────────────
RETENTION_DAYS=31
RETENTION_KEEP_LATEST=true
# Daily retention and weekly orphan sweep (cron, UTC); rows per delete batch.
RETENTION_CRON=30 3 * * *
RETENTION_SWEEP_CRON=0 4 * * 0
RETENTION_BATCH_SIZE=5000
# Objects younger than this are never treated as orphans (uploads precede the row commit).
RETENTION_ORPHAN_MIN_AGE_MS=3600000

# ─── Rate limiting ─────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Per key AND per route for scan triggers, export, rescan, rescore, recapture, bulk, retention run.
THROTTLE_EXPENSIVE_LIMIT=10

# ─── Worker: comma-separated queue names this process serves ──────────
WORKER_QUEUES=

# ─── Analyst workflow ───
# API key *names* (from API_KEYS) allowed to act on behalf of a user via the x-acting-user
# header — e.g. the manage-feed gateway key. Other keys are always recorded as themselves.
TRUSTED_PROXY_KEYS=
# Upper bound for one GET /scanned-domains/export.
EXPORT_MAX_ROWS=100000

# ─── Phase 4: reliability & observability ───
# Transactional outbox: after-commit events are redelivered by a process of the same role if the
# producer dies before delivering them (PROCESS_ROLE is set by the entry point; don't set it).
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_GRACE_MS=30000
OUTBOX_MAX_ATTEMPTS=10
# Prometheus: API serves /api/v1/metrics, each worker serves :METRICS_PORT/metrics.
# Set METRICS_TOKEN (≥ 16 chars) to require "Authorization: Bearer <token>" on both.
METRICS_PORT=9464
METRICS_TOKEN=
# docker compose --profile observability: Grafana admin password (empty → set on first login).
GRAFANA_ADMIN_PASSWORD=

# ─── Phase 5: alerting ───
# 32-byte key (openssl rand -hex 32) encrypting channel targets and webhook secrets at rest.
# Alerting endpoints answer 503 until it is set.
ALERT_ENCRYPTION_KEY=
# Daily digest (cron, UTC) for DIGEST subscriptions.
ALERT_DIGEST_CRON=0 8 * * *
# Deep links in alerts → <console>/lookalikes/<id> (manage-feed URL).
ALERT_CONSOLE_URL=
# SSRF guard: webhook / Slack targets must be https on public addresses. Relax only for an internal relay.
ALERT_ALLOW_PRIVATE_TARGETS=false
ALERT_ALLOW_INSECURE_TARGETS=false
ALERT_TIMEOUT_MS=10000
# E-mail channels: smtp(s)://user:pass@host:port
SMTP_URL=
ALERT_EMAIL_FROM=Fuzzer Scanner <alerts@example.com>

# ─── Phase 5: Certificate Transparency monitoring ───
# A worker serving the `ct-matches` queue consumes a certstream-compatible WebSocket (one leader
# across replicas) and tracks certificates whose names imitate a brand.
CT_MONITOR_ENABLED=false
# Self-host certstream-server-go in production (the public endpoint is best-effort).
CT_STREAM_URL=wss://certstream.calidog.io/
# Brand labels shorter than this are matched only as typos, never as substrings (noise).
CT_MIN_KEYWORD_LENGTH=5
CT_MAX_EDIT_DISTANCE=2
CT_STALL_TIMEOUT_MS=120000

# ─── Phase 5: shared auth with threat-feed ───
# threat-feed's JWT_SECRET. When set, threat-feed user tokens are accepted as
# "Authorization: Bearer <token>" alongside API keys; identity and role come from
# threat-feed GET /auth/me (THREAT_FEED_URL), cached per token for AUTH_IDENTITY_CACHE_MS.
# AUTH_JWT_SECRET=
AUTH_IDENTITY_CACHE_MS=60000
